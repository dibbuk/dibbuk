# Токен от @BotFather — единственная обязательная переменная.
BOT_TOKEN=

# Сколько нарезок в сутки доступно бесплатно.
FREE_DAILY_LIMIT=5

# Приписка к названию пака на бесплатном тарифе.
# {bot} подставляется автоматически. Это и пейволл, и главный канал роста.
BRANDING_SUFFIX=| @{bot}

# Цены в Telegram Stars.
STARS_PRICE_UNBRAND=25
STARS_PRICE_SUBSCRIPTION=250

# Анимированные паки. Требуют ffmpeg с libvpx-vp9;
# без ffmpeg бот сам отключит анимацию при старте.
ENABLE_ANIMATION=true

# Предел размера входного файла в байтах. Bot API всё равно не отдаст больше 20 МБ.
MAX_INPUT_BYTES=20971520
